{
  "name": "ymk",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "main.js",
  "scripts": {
    "dev": "vite --port 5201",
    "startHMR": "nodemon --exec electron .",
    "start": "electron-forge start",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --build --force",
    "EBbuild": "vite build && electron-builder",
    "buildS": "vite build && electron-builder --dir --publish never",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "makes": "electron-forge make --skip-package",
    "clean": "node ./release/clean.js",
    "debug": "npm-run-all --parallel dev start",
    "build": "pnpm build-only && pnpm package && pnpm clean && pnpm makes",
    
    "sdk:build": "pnpm --filter @yumuzk/plugin-api build"
  },
  "dependencies": {
    "NeteaseCloudMusicApi": "^4.31.0",
    "axios": "^1.15.0",
    "crypto-js": "^4.2.0",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "express-fileupload": "^1.5.2",
    "floating-vue": "^5.2.2",
    "fuse.js": "^7.1.0",
    "js-base64": "^3.7.8",
    "md5": "^2.3.0",
    "music-metadata": "^11.12.3",
    "node-forge": "^1.4.0",
    "normalize.css": "^8.0.1",
    "pac-proxy-agent": "^7.2.0",
    "pako": "^2.1.0",
    "pinia": "^2.3.1",
    "pinyin-pro": "^3.27.0",
    "qrcode": "^1.5.4",
    "simplebar-vue": "^2.4.2",
    "tunnel": "^0.0.6",
    "vue": "^3.5.22",
    "vue-draggable-plus": "^0.5.6",
    "vue-pick-colors": "^1.8.0",
    "vue-router": "^4.6.3",
    "xml2js": "^0.6.2",
    "yargs": "^17.7.2"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.10.2",
    "@electron-forge/maker-deb": "^7.10.2",
    "@electron-forge/maker-zip": "^7.10.2",
    "@tsconfig/node20": "^20.1.6",
    "@yumuzk/plugin-api": "workspace:*",
    "@types/express": "^5.0.3",
    "@types/express-fileupload": "^1.5.1",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.18.12",
    "@types/qrcode": "^1.5.5",
    "@typescript-eslint/eslint-plugin": "8.8.0",
    "@typescript-eslint/parser": "8.8.0",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vue/tsconfig": "^0.5.1",
    "electron": "^41.2.1",
    "husky": "9.1.6",
    "intelli-espower-loader": "1.1.0",
    "lint-staged": "15.2.10",
    "mocha": "10.7.3",
    "npm-run-all2": "^6.2.6",
    "pkg": "^5.8.1",
    "power-assert": "1.6.1",
    "typescript": "~5.6.3",
    "vite": "^8.0.8",
    "vite-plugin-vue-devtools": "^8.1.1",
    "vue-tsc": "^2.2.12"
  }
}
